<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<BorderPane fx:id="rootPane" prefHeight="700.0" prefWidth="980.0"
            style="-fx-background-color: #F5F7FB; -fx-font-family: 'Segoe UI', sans-serif;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.ni.edu.uam.casopracticog5.controller.MainController">

    <!-- Área Superior: MenuBar Índigo + ToolBar estilizada con iconos -->
    <top>
        <VBox>
            <children>
                <!-- MenuBar institucional índigo -->
                <MenuBar style="-fx-background-color: #3F51B5; -fx-padding: 4 8 4 8;">
                    <menus>
                        <Menu text="Archivo" style="-fx-text-fill: white;">
                            <items>
                                <MenuItem onAction="#onCerrarSesion" text="Cerrar sesión" />
                                <MenuItem onAction="#onSalir" text="Salir" />
                            </items>
                        </Menu>

                        <Menu text="Navegación">
                            <items>
                                <MenuItem onAction="#onAbrirRegistro" text="Registro de Clientes" />
                                <MenuItem onAction="#onAbrirConsulta" text="Consulta de Clientes" />
                                <MenuItem onAction="#onAbrirAdminUsuarios" text="Panel de Administración" />
                            </items>
                        </Menu>

                        <Menu text="Administración">
                            <items>
                                <MenuItem onAction="#onAbrirAdminUsuarios" text="Gestión de Usuarios..." />
                            </items>
                        </Menu>

                        <Menu text="Ayuda">
                            <items>
                                <MenuItem onAction="#onAcercaDe" text="Acerca del Sistema" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <!-- ToolBar moderna con fondo Índigo suave (#E8EAF6) con iconos y tooltips -->
                <ToolBar style="-fx-background-color: #E8EAF6; -fx-padding: 8 16 8 16; -fx-border-color: #C5CAE9; -fx-border-width: 0 0 1 0;">
                    <items>
                        <!-- Botón 1: Nuevo Cliente (Icono + Tooltip) -->
                        <Button onAction="#onAbrirRegistro"
                                style="-fx-background-color: #FFFFFF; -fx-border-color: #C5CAE9; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 10 6 10;">
                            <graphic>
                                <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/nuevoCliente.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Registrar nuevo cliente en el sistema" />
                            </tooltip>
                        </Button>

                        <!-- Botón 2: Consultar Clientes (Icono + Tooltip) -->
                        <Button onAction="#onAbrirConsulta"
                                style="-fx-background-color: #FFFFFF; -fx-border-color: #C5CAE9; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 10 6 10;">
                            <graphic>
                                <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/consultarClientes.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Consultar listado de clientes registrados" />
                            </tooltip>
                        </Button>

                        <Separator orientation="VERTICAL">
                            <padding>
                                <Insets left="6.0" right="6.0" />
                            </padding>
                        </Separator>

                        <!-- Botón 3: Panel de Administración de Usuarios (Icono + Tooltip) -->
                        <Button onAction="#onAbrirAdminUsuarios"
                                style="-fx-background-color: #FFFFFF; -fx-border-color: #C5CAE9; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 10 6 10;">
                            <graphic>
                                <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/adminPanel.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Panel de administración y gestión de usuarios" />
                            </tooltip>
                        </Button>
                    </items>
                    <effect>
                        <DropShadow height="8.0" radius="3.5" width="8.0">
                            <color>
                                <Color red="0.0" green="0.0" blue="0.0" opacity="0.06" />
                            </color>
                        </DropShadow>
                    </effect>
                </ToolBar>
            </children>
        </VBox>
    </top>

    <!-- Área Central Dinámica con Dashboard Funcional -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #F5F7FB; -fx-padding: 16 20 16 20;">
            <children>
                <!-- Dashboard Principal -->
                <VBox fx:id="cardBienvenida" alignment="TOP_CENTER" maxWidth="940.0" spacing="14.0">
                    <children>
                        <!-- 1. Fila de Bienvenida y Estado Superior -->
                        <HBox alignment="CENTER_LEFT" spacing="14.0"
                              style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-padding: 14 18; -fx-border-color: #E8EAF6; -fx-border-radius: 10; -fx-border-width: 1;">
                            <effect>
                                <DropShadow height="10.0" radius="4.5" width="10.0">
                                    <color>
                                        <Color red="0.247" green="0.317" blue="0.709" opacity="0.08" />
                                    </color>
                                </DropShadow>
                            </effect>
                            <children>
                                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="lblBienvenida" text="Panel de Control · ¡Bienvenido!"
                                               style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #1A237E;">
                                            <contextMenu>
                                                <ContextMenu>
                                                    <items>
                                                        <MenuItem onAction="#onAbrirRegistro" text="Ir a Registro" />
                                                        <MenuItem onAction="#onAbrirConsulta" text="Ir a Consulta" />
                                                        <MenuItem onAction="#onAbrirAdminUsuarios" text="Ir a Administración" />
                                                        <SeparatorMenuItem />
                                                        <MenuItem onAction="#onLimpiarVista" text="Volver al Inicio" />
                                                    </items>
                                                </ContextMenu>
                                            </contextMenu>
                                        </Label>
                                        <Label fx:id="lblFechaDashboard" text="Resumen operativo y accesos directos del sistema"
                                               style="-fx-font-size: 12px; -fx-text-fill: #5C6BC0;" />
                                    </children>
                                </VBox>

                                <Label fx:id="lblBadgeRol" text=" MODO ADMINISTRADOR"
                                       style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-border-color: #C8E6C9; -fx-border-radius: 16; -fx-background-radius: 16; -fx-padding: 5 12; -fx-font-weight: bold; -fx-font-size: 11px;">
                                    <graphic>
                                        <ImageView fx:id="imgBadgeRol" fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../images/administracion.png" />
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </Label>

                                <Button onAction="#onRefrescarDashboard" text=" Actualizar"
                                        style="-fx-background-color: #FFFFFF; -fx-border-color: #C5CAE9; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 12; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3F51B5;">
                                    <graphic>
                                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../images/actualizar.png" />
                                            </image>
                                        </ImageView>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Refrescar métricas y estadísticas del sistema" />
                                    </tooltip>
                                </Button>
                            </children>
                        </HBox>

                        <!-- 2. Fila de KPIs / Métricas en Tarjetas -->
                        <HBox spacing="14.0">
                            <children>
                                <!-- KPI 1: Clientes Totales -->
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-padding: 12 16; -fx-border-color: #E8EAF6; -fx-border-radius: 10; -fx-border-width: 1;">
                                    <effect>
                                        <DropShadow height="10.0" radius="4.5" width="10.0">
                                            <color>
                                                <Color red="0.247" green="0.317" blue="0.709" opacity="0.08" />
                                            </color>
                                        </DropShadow>
                                    </effect>
                                    <children>
                                        <Label text="DIRECTORIO DE CLIENTES"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #7986CB;" />
                                        <HBox alignment="BASELINE_LEFT" spacing="6.0">
                                            <children>
                                                <Label fx:id="lblTotalClientesDash" text="4"
                                                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3F51B5;" />
                                                <Label text="registrados"
                                                       style="-fx-font-size: 12px; -fx-text-fill: #757575;" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblSubClientesDash" text="4 Naturales · 0 Jurídicos"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;" />
                                    </children>
                                </VBox>

                                <!-- KPI 2: Cobertura Territorial -->
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-padding: 12 16; -fx-border-color: #E8EAF6; -fx-border-radius: 10; -fx-border-width: 1;">
                                    <effect>
                                        <DropShadow height="10.0" radius="4.5" width="10.0">
                                            <color>
                                                <Color red="0.247" green="0.317" blue="0.709" opacity="0.08" />
                                            </color>
                                        </DropShadow>
                                    </effect>
                                    <children>
                                        <Label text="COBERTURA TERRITORIAL"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #7986CB;" />
                                        <HBox alignment="BASELINE_LEFT" spacing="6.0">
                                            <children>
                                                <Label fx:id="lblTotalCiudadesDash" text="4 ciudades"
                                                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblSubCiudadesDash" text="Managua, León, Granada, Masaya"
                                               style="-fx-font-size: 11px; -fx-text-fill: #757575;" />
                                    </children>
                                </VBox>

                                <!-- KPI 3: Cuentas y Seguridad -->
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-padding: 12 16; -fx-border-color: #E8EAF6; -fx-border-radius: 10; -fx-border-width: 1;">
                                    <effect>
                                        <DropShadow height="10.0" radius="4.5" width="10.0">
                                            <color>
                                                <Color red="0.247" green="0.317" blue="0.709" opacity="0.08" />
                                            </color>
                                        </DropShadow>
                                    </effect>
                                    <children>
                                        <Label text="CUENTAS DE USUARIO"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #7986CB;" />
                                        <HBox alignment="BASELINE_LEFT" spacing="6.0">
                                            <children>
                                                <Label fx:id="lblTotalUsuariosDash" text="2"
                                                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #E65100;" />
                                                <Label text="cuentas"
                                                       style="-fx-font-size: 12px; -fx-text-fill: #757575;" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblSubUsuariosDash" text="1 Admin · 1 Operador"
                                               style="-fx-font-size: 11px; -fx-text-fill: #757575;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- 3. Sección Dividida: Accesos Rápidos (Izq) y Clientes Recientes (Der) -->
                        <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                            <children>
                                <!-- Columna Izquierda: Accesos Rápidos -->
                                <VBox prefWidth="320.0" spacing="10.0"
                                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-padding: 14; -fx-border-color: #E8EAF6; -fx-border-radius: 10; -fx-border-width: 1;">
                                    <effect>
                                        <DropShadow height="10.0" radius="4.5" width="10.0">
                                            <color>
                                                <Color red="0.247" green="0.317" blue="0.709" opacity="0.08" />
                                            </color>
                                        </DropShadow>
                                    </effect>
                                    <children>
                                        <Label text="⚡ Accesos Rápidos"
                                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3F51B5;" />

                                        <!-- Botón 1: Nuevo Cliente -->
                                        <Button onAction="#onAbrirRegistro" maxWidth="Infinity" alignment="CENTER_LEFT"
                                                text="  Registrar Nuevo Cliente&#10;  Alta con validación y formulario"
                                                style="-fx-background-color: #F8F9FE; -fx-border-color: #C5CAE9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12; -fx-cursor: hand; -fx-font-size: 12px; -fx-font-family: 'Segoe UI';">
                                            <graphic>
                                                <ImageView fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                                                    <image>
                                                        <Image url="@../images/nuevoCliente.png" />
                                                    </image>
                                                </ImageView>
                                            </graphic>
                                            <tooltip>
                                                <Tooltip text="Abrir formulario para registrar un nuevo cliente" />
                                            </tooltip>
                                        </Button>

                                        <!-- Botón 2: Consultar Clientes -->
                                        <Button onAction="#onAbrirConsulta" maxWidth="Infinity" alignment="CENTER_LEFT"
                                                text="  Consultar Directorio&#10;  Búsqueda, listado y detalle modal"
                                                style="-fx-background-color: #F8F9FE; -fx-border-color: #C5CAE9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12; -fx-cursor: hand; -fx-font-size: 12px; -fx-font-family: 'Segoe UI';">
                                            <graphic>
                                                <ImageView fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                                                    <image>
                                                        <Image url="@../images/consultarClientes.png" />
                                                    </image>
                                                </ImageView>
                                            </graphic>
                                            <tooltip>
                                                <Tooltip text="Abrir consulta y catálogo de clientes" />
                                            </tooltip>
                                        </Button>

                                        <!-- Botón 3: Panel de Administración -->
                                        <Button onAction="#onAbrirAdminUsuarios" maxWidth="Infinity" alignment="CENTER_LEFT"
                                                text="  Gestión de Usuarios&#10;  Cuentas, roles y permisos RBAC"
                                                style="-fx-background-color: #F8F9FE; -fx-border-color: #C5CAE9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12; -fx-cursor: hand; -fx-font-size: 12px; -fx-font-family: 'Segoe UI';">
                                            <graphic>
                                                <ImageView fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                                                    <image>
                                                        <Image url="@../images/adminPanel.png" />
                                                    </image>
                                                </ImageView>
                                            </graphic>
                                            <tooltip>
                                                <Tooltip text="Gestionar cuentas de usuario y seguridad del sistema" />
                                            </tooltip>
                                        </Button>
                                    </children>
                                </VBox>

                                <!-- Columna Derecha: Clientes Recientes -->
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-padding: 14; -fx-border-color: #E8EAF6; -fx-border-radius: 10; -fx-border-width: 1;">
                                    <effect>
                                        <DropShadow height="10.0" radius="4.5" width="10.0">
                                            <color>
                                                <Color red="0.247" green="0.317" blue="0.709" opacity="0.08" />
                                            </color>
                                        </DropShadow>
                                    </effect>
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="👥 Clientes Registrados en el Sistema"
                                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3F51B5;" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button onAction="#onAbrirConsulta" text="Ver todos en Consulta →"
                                                        style="-fx-background-color: transparent; -fx-text-fill: #3F51B5; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" />
                                            </children>
                                        </HBox>

                                        <TableView fx:id="tablaClientesDashboard" VBox.vgrow="ALWAYS" prefHeight="190.0"
                                                   style="-fx-background-color: transparent; -fx-border-color: #E8EAF6; -fx-border-radius: 6;">
                                            <columns>
                                                <TableColumn fx:id="colDashNombre" prefWidth="230.0" text="Nombre Completo" />
                                                <TableColumn fx:id="colDashTipo" prefWidth="90.0" text="Tipo" />
                                                <TableColumn fx:id="colDashCiudad" prefWidth="110.0" text="Ciudad" />
                                                <TableColumn fx:id="colDashFecha" prefWidth="110.0" text="Nacimiento" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                            <placeholder>
                                                <Label text="No hay clientes registrados aún" style="-fx-text-fill: #757575;" />
                                            </placeholder>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>

    <!-- Barra Inferior de Estado: Fondo Índigo Suave (#E8EAF6) -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12.0"
              style="-fx-background-color: #E8EAF6; -fx-padding: 8 16 8 16; -fx-border-color: #C5CAE9; -fx-border-width: 1 0 0 0;">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #3F51B5; -fx-font-size: 12px;" text="Sesión activa:" />
                <Label fx:id="lblSesionUsuario" text="admin (ADMINISTRADOR)" textOverrun="ELLIPSIS"
                       style="-fx-text-fill: #333333; -fx-font-size: 12px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Sistema de Gestión de Clientes · UAM 2026"
                       style="-fx-text-fill: #7986CB; -fx-font-size: 11px; -fx-font-style: italic;" />
            </children>
        </HBox>
    </bottom>

</BorderPane>