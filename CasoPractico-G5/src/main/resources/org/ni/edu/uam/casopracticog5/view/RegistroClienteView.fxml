<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="880.0" prefHeight="680.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.ni.edu.uam.casopracticog5.controller.RegistroClienteController">
    <fx:define>
        <ToggleGroup fx:id="grupoSolicitud"/>
    </fx:define>
    <top>
        <VBox spacing="8.0">
            <padding><Insets top="24.0" right="24.0" bottom="16.0" left="24.0"/></padding>
            <Label text="Registro de clientes" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Completa los datos del cliente. Los campos con * son obligatorios." wrapText="true"/>
            <Separator/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <GridPane hgap="24.0" vgap="20.0">
                    <padding><Insets top="16.0" right="24.0" bottom="24.0" left="24.0"/></padding>
                    <columnConstraints>
                        <ColumnConstraints percentWidth="68.0" hgrow="ALWAYS" minWidth="280.0"/>
                        <ColumnConstraints percentWidth="32.0" minWidth="180.0"/>
                    </columnConstraints>
                    <VBox spacing="16.0" GridPane.columnIndex="0">
                        <Label text="Datos personales" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <VBox spacing="6.0">
                            <Label text="Nombres *"/>
                            <TextField fx:id="txtNombres" promptText="Ej.: María José"/>
                        </VBox>
                        <VBox spacing="6.0">
                            <Label text="Apellidos *"/>
                            <TextField fx:id="txtApellidos" promptText="Ej.: Hernández López"/>
                        </VBox>
                        <GridPane hgap="16.0" vgap="14.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <VBox spacing="6.0" GridPane.columnIndex="0">
                                <Label text="Tipo de cliente *"/>
                                <ComboBox fx:id="cmbTipoCliente" promptText="Selecciona un tipo" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6.0" GridPane.columnIndex="1">
                                <Label text="Ciudad *"/>
                                <ComboBox fx:id="cmbCiudad" promptText="Selecciona una ciudad" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6.0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                <Label text="Fecha de nacimiento *"/>
                                <DatePicker fx:id="dpFechaNacimiento" editable="false"
                                            promptText="dd/mm/aaaa" maxWidth="Infinity"/>
                                <Label text="Selecciona la fecha en el calendario." style="-fx-font-size: 11px;"/>
                            </VBox>
                        </GridPane>
                        <Separator/>
                        <VBox spacing="8.0">
                            <Label text="Tipo de solicitud *" style="-fx-font-weight: bold;"/>
                            <FlowPane hgap="20.0" vgap="8.0">
                                <RadioButton text="Nuevo servicio" toggleGroup="$grupoSolicitud"/>
                                <RadioButton text="Renovación" toggleGroup="$grupoSolicitud"/>
                            </FlowPane>
                        </VBox>
                        <VBox spacing="8.0">
                            <Label text="Servicios de interés *" style="-fx-font-weight: bold;"/>
                            <Label text="Puedes seleccionar más de uno."/>
                            <FlowPane hgap="18.0" vgap="8.0">
                                <CheckBox fx:id="chkAsesoria" text="Asesoría"/>
                                <CheckBox fx:id="chkSoporte" text="Soporte técnico"/>
                                <CheckBox fx:id="chkCapacitacion" text="Capacitación"/>
                            </FlowPane>
                        </VBox>
                    </VBox>
                    <VBox spacing="12.0" alignment="TOP_CENTER" GridPane.columnIndex="1">
                        <Label text="Fotografía (opcional)" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <StackPane minHeight="200.0" prefHeight="200.0"
                                   style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4px;">
                            <ImageView fx:id="imgFotografia" fitWidth="160.0" fitHeight="185.0"
                                       preserveRatio="true" smooth="true"/>
                        </StackPane>
                        <Label fx:id="lblFotografia" text="Sin fotografía seleccionada"
                               wrapText="true" maxWidth="210.0" alignment="CENTER" textAlignment="CENTER"/>
                        <Button text="Seleccionar fotografía" onAction="#seleccionarFotografia" maxWidth="Infinity"/>
                        <Button text="Quitar fotografía" onAction="#quitarFotografia" maxWidth="Infinity"/>
                        <Label text="PNG, JPG, GIF o BMP · Máximo 5 MB"
                               wrapText="true" textAlignment="CENTER" style="-fx-font-size: 11px;"/>
                    </VBox>
                </GridPane>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="12.0" alignment="CENTER_RIGHT">
            <padding><Insets top="16.0" right="24.0" bottom="20.0" left="24.0"/></padding>
            <Button text="Limpiar" onAction="#limpiarFormulario" prefWidth="110.0"/>
            <Button text="Guardar cliente" onAction="#guardarCliente" defaultButton="true" prefWidth="150.0"/>
        </HBox>
    </bottom>
</BorderPane>
