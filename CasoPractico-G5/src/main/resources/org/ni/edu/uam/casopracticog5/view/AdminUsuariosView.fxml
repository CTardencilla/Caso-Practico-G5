<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.ni.edu.uam.casopracticog5.controller.AdminUsuariosController"
      style="-fx-background-color: #F5F7FB;">

    <!-- Barra superior índigo -->
    <HBox alignment="CENTER_LEFT" prefHeight="60"
          style="-fx-background-color: #3F51B5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 3);">
        <padding>
            <Insets left="25" right="25"/>
        </padding>
        <Label text="Panel de Administración - Gestión de Usuarios"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Segoe UI';"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblEstadoPermisos" text="Permisos: ADMINISTRADOR"
               style="-fx-font-size: 13px; -fx-text-fill: #C5CAE9; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
    </HBox>

    <!-- Contenido Principal -->
    <VBox spacing="16" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="18" right="25" bottom="18" left="25"/>
        </padding>

        <!-- Banner de aviso si no tiene permisos -->
        <HBox fx:id="bannerPermisos" alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #FFF3E0; -fx-border-color: #FFE0B2; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 14;">
            <Label fx:id="lblMensajeBanner" text="Gestión de usuarios y asignación de credenciales y roles del sistema."
                   style="-fx-text-fill: #E65100; -fx-font-size: 12px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
        </HBox>

        <!-- Contenedor de dos tarjetas: Formulario a la izquierda y Tabla a la derecha -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">

            <!-- Tarjeta Izquierda: Formulario -->
            <VBox spacing="0" prefWidth="350" minWidth="320"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                <!-- Encabezado de tarjeta -->
                <HBox alignment="CENTER_LEFT" prefHeight="40"
                      style="-fx-background-color: #E8EAF6; -fx-background-radius: 8 8 0 0;">
                    <padding>
                        <Insets left="15"/>
                    </padding>
                    <Label text="Datos del Usuario"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3F51B5; -fx-font-family: 'Segoe UI';"/>
                </HBox>

                <VBox spacing="14" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>

                    <!-- Nombre Completo -->
                    <VBox spacing="5">
                        <Label text="Nombre Completo *" style="-fx-font-weight: bold; -fx-text-fill: #333333; -fx-font-size: 12px;"/>
                        <TextField fx:id="txtNombreCompleto" promptText="Ej. Carlos Mendoza"
                                   style="-fx-background-color: #FAFAFA; -fx-border-color: #D6DBED; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 7 10; -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Nombre de Usuario -->
                    <VBox spacing="5">
                        <Label text="Nombre de Usuario *" style="-fx-font-weight: bold; -fx-text-fill: #333333; -fx-font-size: 12px;"/>
                        <TextField fx:id="txtUsername" promptText="Ej. cmendoza"
                                   style="-fx-background-color: #FAFAFA; -fx-border-color: #D6DBED; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 7 10; -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Contraseña -->
                    <VBox spacing="5">
                        <Label text="Contraseña *" style="-fx-font-weight: bold; -fx-text-fill: #333333; -fx-font-size: 12px;"/>
                        <PasswordField fx:id="txtPassword" promptText="Mínimo 4 caracteres"
                                       style="-fx-background-color: #FAFAFA; -fx-border-color: #D6DBED; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 7 10; -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Rol -->
                    <VBox spacing="5">
                        <Label text="Rol / Permisos *" style="-fx-font-weight: bold; -fx-text-fill: #333333; -fx-font-size: 12px;"/>
                        <ComboBox fx:id="cmbRol" promptText="Seleccione el rol" maxWidth="1.7976931348623157E308"
                                  style="-fx-background-color: #FAFAFA; -fx-border-color: #D6DBED; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                    </VBox>

                    <!-- Activo -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <CheckBox fx:id="chkActivo" text="Usuario activo (permite iniciar sesión)" selected="true"
                                  style="-fx-font-size: 12px; -fx-text-fill: #333333;"/>
                    </HBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <!-- Botones de Acción Formulario -->
                    <VBox spacing="8">
                        <Button fx:id="btnGuardar" text="Crear Usuario" onAction="#onGuardarUsuario"
                                maxWidth="1.7976931348623157E308" prefHeight="35"
                                style="-fx-background-color: #3F51B5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;">
                            <tooltip>
                                <Tooltip text="Registrar nuevo usuario en el sistema"/>
                            </tooltip>
                        </Button>

                        <HBox spacing="8">
                            <Button fx:id="btnActualizar" text="Actualizar" onAction="#onActualizarUsuario" disable="true"
                                    HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" prefHeight="32"
                                    style="-fx-background-color: #5C6BC0; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;">
                                <tooltip>
                                    <Tooltip text="Guardar cambios del usuario seleccionado"/>
                                </tooltip>
                            </Button>

                            <Button fx:id="btnLimpiar" text="Limpiar" onAction="#onLimpiarFormulario"
                                    HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" prefHeight="32"
                                    style="-fx-background-color: #E8EAF6; -fx-text-fill: #3F51B5; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;">
                                <tooltip>
                                    <Tooltip text="Limpiar campos del formulario"/>
                                </tooltip>
                            </Button>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>

            <!-- Tarjeta Derecha: Tabla de Usuarios -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                <!-- Encabezado de tabla -->
                <HBox alignment="CENTER_LEFT" prefHeight="40"
                      style="-fx-background-color: #E8EAF6; -fx-background-radius: 8 8 0 0;">
                    <padding>
                        <Insets left="15" right="15"/>
                    </padding>
                    <Label text="Usuarios Registrados"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3F51B5; -fx-font-family: 'Segoe UI';"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotalUsuarios" text="Total: 0 usuarios"
                           style="-fx-font-size: 12px; -fx-text-fill: #5C6BC0; -fx-font-weight: bold;"/>
                </HBox>

                <VBox spacing="10" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="10" right="14" bottom="14" left="14"/>
                    </padding>

                    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: white; -fx-table-cell-border-color: #E8EAF6; -fx-font-family: 'Segoe UI';">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colUsername" text="Usuario" prefWidth="120"
                                         style="-fx-alignment: CENTER-LEFT;"/>
                            <TableColumn fx:id="colNombre" text="Nombre Completo" prefWidth="160"
                                         style="-fx-alignment: CENTER-LEFT;"/>
                            <TableColumn fx:id="colRol" text="Rol" prefWidth="130"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="90"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colFecha" text="Fecha Alta" prefWidth="110"
                                         style="-fx-alignment: CENTER;"/>
                        </columns>
                    </TableView>

                    <!-- Botones de Acción de Tabla -->
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="Selecciona un usuario de la lista para modificarlo o eliminarlo."
                               style="-fx-font-size: 11px; -fx-text-fill: #9FA8DA; -fx-font-style: italic;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnModificar" text="Modificar" onAction="#onModificarUsuario" disable="true"
                                prefHeight="34" prefWidth="110"
                                style="-fx-background-color: #5C6BC0; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;">
                            <tooltip>
                                <Tooltip text="Cargar usuario en formulario para editar"/>
                            </tooltip>
                        </Button>

                        <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminarUsuario" disable="true"
                                prefHeight="34" prefWidth="110"
                                style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;">
                            <tooltip>
                                <Tooltip text="Eliminar usuario del sistema (requiere confirmación)"/>
                            </tooltip>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>

        </HBox>
    </VBox>

</VBox>
