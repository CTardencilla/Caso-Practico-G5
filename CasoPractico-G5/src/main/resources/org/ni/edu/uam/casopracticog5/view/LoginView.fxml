<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="panelPrincipal" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="350.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ni.edu.uam.casopracticog5.controller.LoginController">
   <children>
      <!-- Ícono Principal (Centrado con fondo circular azul índigo) -->
      <StackPane layoutX="125.0" layoutY="40.0" prefHeight="100.0" prefWidth="100.0">
         <children>
            <Circle fill="#3F51B5" radius="50.0" stroke="TRANSPARENT" strokeType="INSIDE" />
            <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/usuarioG.png" />
               </image>
            </ImageView>
         </children>
      </StackPane>

      <!-- Campo de Usuario (Fondo unificado gris) -->
      <HBox alignment="CENTER_LEFT" layoutX="40.0" layoutY="180.0" prefHeight="45.0" prefWidth="270.0" style="-fx-background-color: #F5F5F5; -fx-background-radius: 5;">
         <children>
            <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/usuario.png" />
               </image>
               <HBox.margin>
                  <Insets left="15.0" right="10.0" />
               </HBox.margin>
            </ImageView>
            <TextField fx:id="txtUsuario" onKeyPressed="#detectarEnter" prefHeight="45.0" prefWidth="220.0" promptText="Usuario" style="-fx-background-color: transparent; -fx-text-fill: #333333;">
               <font>
                  <Font name="Segoe UI" size="14.0" />
               </font>
            </TextField>
         </children>
      </HBox>

      <!-- Campo de Contraseña (Fondo unificado gris con detección de ENTER) -->
      <HBox alignment="CENTER_LEFT" layoutX="40.0" layoutY="240.0" prefHeight="45.0" prefWidth="270.0" style="-fx-background-color: #F5F5F5; -fx-background-radius: 5;">
         <children>
            <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/candado.png" />
               </image>
               <HBox.margin>
                  <Insets left="15.0" right="10.0" />
               </HBox.margin>
            </ImageView>
            <PasswordField fx:id="txtPassword" onKeyPressed="#detectarEnter" prefHeight="45.0" prefWidth="220.0" promptText="Contraseña" style="-fx-background-color: transparent; -fx-text-fill: #333333;">
               <font>
                  <Font name="Segoe UI" size="14.0" />
               </font>
            </PasswordField>
         </children>
      </HBox>

      <!-- Botón de Ingreso (Acento azul índigo) -->
      <Button layoutX="40.0" layoutY="310.0" mnemonicParsing="false" onAction="#iniciarSesion" prefHeight="45.0" prefWidth="270.0" style="-fx-background-color: #3F51B5; -fx-background-radius: 5; -fx-cursor: hand;" text="Ingresar" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="15.0" />
         </font>
      </Button>

      <!-- Botón de Salir (Diseño minimalista integrado) -->
      <HBox alignment="CENTER" layoutX="40.0" layoutY="380.0" onMouseClicked="#salir" prefHeight="30.0" prefWidth="270.0" style="-fx-cursor: hand;">
         <children>
            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/salir.png" />
               </image>
               <HBox.margin>
                  <Insets right="8.0" />
               </HBox.margin>
            </ImageView>
            <Label text="Salir del sistema" textFill="#757575">
               <font>
                  <Font name="Segoe UI" size="13.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </children>
</AnchorPane>
