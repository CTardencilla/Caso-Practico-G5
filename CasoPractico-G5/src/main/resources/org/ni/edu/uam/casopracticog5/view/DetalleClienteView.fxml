<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox spacing="0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.ni.edu.uam.casopracticog5.controller.DetalleClienteController"
      style="-fx-background-color: #F5F7FB;">

    <!-- Barra superior índigo -->
    <HBox alignment="CENTER_LEFT" prefHeight="56"
          style="-fx-background-color: #3F51B5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 3);">
        <padding>
            <Insets left="25"/>
        </padding>
        <Label text="Detalle del Cliente"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Segoe UI';"/>
    </HBox>

    <!-- Contenido principal -->
    <VBox spacing="18" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="22" right="25" bottom="20" left="25"/>
        </padding>

        <!-- Contenido: datos + foto -->
        <HBox spacing="25" alignment="TOP_CENTER">

            <!-- Tarjeta izquierda: información del cliente -->
            <VBox spacing="0" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                <!-- Encabezado de tarjeta -->
                <HBox alignment="CENTER_LEFT" prefHeight="38"
                      style="-fx-background-color: #E8EAF6; -fx-background-radius: 8 8 0 0;">
                    <padding>
                        <Insets left="15"/>
                    </padding>
                    <Label text="Información Personal"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #3F51B5; -fx-font-family: 'Segoe UI';"/>
                </HBox>

                <!-- Datos en GridPane -->
                <GridPane hgap="15" vgap="12">
                    <padding>
                        <Insets top="15" right="18" bottom="18" left="18"/>
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints minWidth="140" prefWidth="150"/>
                        <ColumnConstraints minWidth="180" prefWidth="220"/>
                    </columnConstraints>

                    <!-- Fila 0: Nombres -->
                    <Label text="Nombres:"
                           style="-fx-font-weight: bold; -fx-text-fill: #5C6BC0; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="lblNombres"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333; -fx-font-family: 'Segoe UI';"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <!-- Fila 1: Apellidos -->
                    <Label text="Apellidos:"
                           style="-fx-font-weight: bold; -fx-text-fill: #5C6BC0; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="lblApellidos"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333; -fx-font-family: 'Segoe UI';"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <!-- Fila 2: Tipo de Cliente -->
                    <Label text="Tipo de Cliente:"
                           style="-fx-font-weight: bold; -fx-text-fill: #5C6BC0; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label fx:id="lblTipoCliente"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333; -fx-font-family: 'Segoe UI';"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <!-- Fila 3: Ciudad -->
                    <Label text="Ciudad:"
                           style="-fx-font-weight: bold; -fx-text-fill: #5C6BC0; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';"
                           GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Label fx:id="lblCiudad"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333; -fx-font-family: 'Segoe UI';"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <!-- Fila 4: Fecha de Nacimiento -->
                    <Label text="Fecha de Nacimiento:"
                           style="-fx-font-weight: bold; -fx-text-fill: #5C6BC0; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';"
                           GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <Label fx:id="lblFechaNacimiento"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333; -fx-font-family: 'Segoe UI';"
                           GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <!-- Fila 5: Tipo de Solicitud -->
                    <Label text="Tipo de Solicitud:"
                           style="-fx-font-weight: bold; -fx-text-fill: #5C6BC0; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';"
                           GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <Label fx:id="lblTipoSolicitud"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333; -fx-font-family: 'Segoe UI';"
                           GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                </GridPane>
            </VBox>

            <!-- Tarjeta derecha: fotografía -->
            <VBox spacing="0" alignment="TOP_CENTER" prefWidth="210"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                <HBox alignment="CENTER" prefHeight="38"
                      style="-fx-background-color: #E8EAF6; -fx-background-radius: 8 8 0 0;">
                    <Label text="Fotografía"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #3F51B5; -fx-font-family: 'Segoe UI';"/>
                </HBox>

                <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                    <ImageView fx:id="imgFotografia" fitWidth="170" fitHeight="190" preserveRatio="true"
                               style="-fx-effect: dropshadow(gaussian, rgba(63,81,181,0.25), 8, 0, 0, 2);"/>
                </VBox>
            </VBox>

        </HBox>

        <!-- Tarjeta de servicios -->
        <VBox spacing="0"
              style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

            <HBox alignment="CENTER_LEFT" prefHeight="38"
                  style="-fx-background-color: #E8EAF6; -fx-background-radius: 8 8 0 0;">
                <padding>
                    <Insets left="15"/>
                </padding>
                <Label text="Servicios Contratados"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #3F51B5; -fx-font-family: 'Segoe UI';"/>
            </HBox>

            <VBox>
                <padding>
                    <Insets top="8" right="10" bottom="10" left="10"/>
                </padding>
                <ListView fx:id="lstServicios" prefHeight="90"
                          style="-fx-background-color: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;"/>
            </VBox>
        </VBox>

        <!-- Espaciador flexible -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- Botón Cerrar -->
        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="btnCerrar" text="Cerrar" onAction="#cerrarVentana"
                    cancelButton="true"
                    prefWidth="110" prefHeight="35"
                    style="-fx-background-color: #3F51B5; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-family: 'Segoe UI';"/>
        </HBox>
    </VBox>

</VBox>
