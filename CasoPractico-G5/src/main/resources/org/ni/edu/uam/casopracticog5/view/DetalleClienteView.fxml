<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.ni.edu.uam.casopracticog5.controller.DetalleClienteController">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <!-- Título -->
    <Label text="Detalle del Cliente" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Separator/>

    <!-- Contenido principal: datos + foto -->
    <HBox spacing="25.0" alignment="TOP_CENTER">

        <!-- Columna izquierda: datos del cliente -->
        <VBox spacing="12.0">
            <GridPane hgap="12.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="130" prefWidth="140"/>
                    <ColumnConstraints minWidth="180" prefWidth="220"/>
                </columnConstraints>

                <!-- Fila 0: Nombres -->
                <Label text="Nombres:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label fx:id="lblNombres" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <!-- Fila 1: Apellidos -->
                <Label text="Apellidos:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="lblApellidos" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <!-- Fila 2: Tipo de Cliente -->
                <Label text="Tipo de Cliente:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label fx:id="lblTipoCliente" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <!-- Fila 3: Ciudad -->
                <Label text="Ciudad:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Label fx:id="lblCiudad" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <!-- Fila 4: Fecha de Nacimiento -->
                <Label text="Fecha de Nacimiento:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <Label fx:id="lblFechaNacimiento" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <!-- Fila 5: Tipo de Solicitud -->
                <Label text="Tipo de Solicitud:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <Label fx:id="lblTipoSolicitud" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            </GridPane>

            <!-- Servicios -->
            <Label text="Servicios:" style="-fx-font-weight: bold;"/>
            <ListView fx:id="lstServicios" prefHeight="100" prefWidth="360"/>
        </VBox>

        <!-- Columna derecha: fotografía -->
        <VBox spacing="8.0" alignment="TOP_CENTER">
            <Label text="Fotografía:" style="-fx-font-weight: bold;"/>
            <ImageView fx:id="imgFotografia" fitWidth="180" fitHeight="200" preserveRatio="true"
                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 6, 0, 0, 2);"/>
        </VBox>

    </HBox>

    <Separator/>

    <!-- Botón Cerrar -->
    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="btnCerrar" text="Cerrar" onAction="#cerrarVentana" prefWidth="100"/>
    </HBox>

</VBox>
