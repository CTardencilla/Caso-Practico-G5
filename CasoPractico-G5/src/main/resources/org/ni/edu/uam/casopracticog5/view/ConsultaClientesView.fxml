<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.ni.edu.uam.casopracticog5.controller.ConsultaClientesController"
      style="-fx-background-color: #F5F7FB;">

    <!-- Barra superior índigo -->
    <HBox alignment="CENTER_LEFT" prefHeight="60"
          style="-fx-background-color: #3F51B5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 3);">
        <padding>
            <Insets left="25"/>
        </padding>
        <Label text="Consulta de Clientes"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Segoe UI';"/>
    </HBox>

    <!-- Contenedor de la tabla con tarjeta blanca -->
    <VBox spacing="12" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="18" right="25" bottom="18" left="25"/>
        </padding>

        <!-- Barra de búsqueda y contador -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2">
                <Label text="Listado de clientes registrados"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3F51B5; -fx-font-family: 'Segoe UI';"/>
                <Label fx:id="lblContador" text="Total: 0 clientes"
                       style="-fx-font-size: 12px; -fx-text-fill: #7986CB; -fx-font-family: 'Segoe UI';"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Campo de búsqueda reactiva -->
            <TextField fx:id="txtBuscar" promptText="Buscar por nombre, apellido, ciudad..."
                       prefHeight="36" prefWidth="280"
                       style="-fx-background-color: white; -fx-border-color: #C5CAE9; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;"/>
        </HBox>

        <!-- Tarjeta contenedora de la tabla -->
        <VBox VBox.vgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
            <padding>
                <Insets top="5" right="5" bottom="5" left="5"/>
            </padding>

            <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-table-cell-border-color: #E8EAF6; -fx-font-family: 'Segoe UI';">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colNombres" text="Nombres / Razón Social" prefWidth="180"
                                 style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="150"
                                 style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colTipoCliente" text="Tipo de Cliente" prefWidth="120"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="120"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colFechaNacimiento" text="Fecha de Nacimiento" prefWidth="150"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colTipoSolicitud" text="Tipo de Solicitud" prefWidth="130"
                                 style="-fx-alignment: CENTER;"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Barra inferior: indicación y botón Ver Detalle -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Tip: Haz doble clic, presiona ENTER o usa el botón 'Ver Detalle'."
                   style="-fx-font-size: 11px; -fx-text-fill: #7986CB; -fx-font-style: italic; -fx-font-family: 'Segoe UI';"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnVerDetalle" text="Ver Detalle" onAction="#onVerDetalle"
                    prefHeight="36" prefWidth="130"
                    style="-fx-background-color: #3F51B5; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-family: 'Segoe UI';"/>
        </HBox>
    </VBox>

</VBox>
